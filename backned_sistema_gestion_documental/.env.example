# Backend SGD — Archivo Central (desarrollo). Copiar a .env.local y completar; nunca subir valores reales.

# PostgreSQL (conexión directa con el driver pg). En desarrollo, la base de despliegue/docker-compose.dev.yml:
#   postgres://sgd_backend:<SGD_BACKEND_PASSWORD>@localhost:5432/sgd
# Con TLS (servidor de base aparte): agregar ?sslmode=require
DATABASE_URL=
# Conexiones simultáneas del backend a la base (por defecto 10)
DATABASE_POOL_MAX=10

# NOVA (autenticación)
NOVA_API_URL=https://nova.uniautonoma.edu.co

# Token de servicio para n8n (distinto del de usuarios)
N8N_SERVICE_TOKEN=cambiar_en_produccion

# Raíz donde se guardan los archivos físicos
RAIZ_ARCHIVOS=./archivos_sgd

# Puerto del backend (dev)
PORT=3000

# Orígenes permitidos para CORS (separados por comas)
ALLOWED_ORIGINS=http://localhost:5173

# Token de desarrollo para probar sin NOVA (solo en desarrollo; dejar vacío en producción)
SGD_DEV_TOKEN=

# Webhooks de n8n que dispara el backend desde la Bandeja (URL completa del nodo Webhook de cada flujo)
N8N_WEBHOOK_REMITIR_URL=
N8N_WEBHOOK_RESPONDER_URL=
N8N_WEBHOOK_RECORDATORIO_URL=
