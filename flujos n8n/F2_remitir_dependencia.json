    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Junta todos los archivos descargados en UN item (attachment_0, attachment_1, ...)\n// para que Gmail los envie en un solo correo\nconst correo = $('Armar correo').first().json;\nconst binary = {};\nconst nombres = [];\nlet fallidos = [];\n$input.all().forEach(it => {\n  if (it.json && it.json.sin_adjuntos) return;\n  const b = it.binary && it.binary.archivo;\n  if (!b) { fallidos.push(it.json && it.json.nombre); return; }\n  const k = `attachment_${nombres.length}`;\n  binary[k] = b;\n  nombres.push(k);\n});\nreturn [{ json: { ...correo, binarios: nombres.join(','), adjuntos_fallidos: fallidos.filter(Boolean) }, binary }];"
      },
