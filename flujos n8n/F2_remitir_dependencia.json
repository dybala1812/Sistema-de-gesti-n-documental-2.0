    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Revisa estado, dependencia y adjuntos, y arma el correo para la dependencia\nconst s = $('Validar solicitud').first().json;\nconst com = $('Leer comunicación').first().json || {};\nconst dep = $('Leer dependencia').first().json || {};\nconst adjTodos = $('Leer adjuntos').all().map(i => i.json).filter(a => a && a.id);\nconst errores = [];\nlet codigo = 422;\n\nif (!com.id) { errores.push('La comunicación no existe.'); codigo = 404; }\nconst permitidos = s.modo === 'devolver' ? ['respondida_dependencia'] : ['nueva', 'devuelta'];\nif (com.id && !permitidos.includes(com.estado)) {\n  errores.push(`No se puede ${s.modo} una comunicación en estado \"${com.estado}\".`); codigo = 409;\n}\nif (!dep.id) errores.push('La dependencia no existe.');\nelse if (dep.activo === false) errores.push('La dependencia está inactiva.');\n\n// Correos de la dependencia: principal + copias (separados por coma o punto y coma)\nconst limpiar = t => (t || '').split(/[;,]/).map(x => x.trim().toLowerCase()).filter(x => /^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(x));\nconst para = limpiar(dep.correo);\nconst copia = limpiar(dep.correos_cc).filter(c => !para.includes(c));\nif (dep.id && !para.length) errores.push(`La dependencia ${dep.nombre || ''} no tiene un correo válido.`);\n\n// Adjuntos: los elegidos en la app o, si no eligió, todos los guardados\nconst adjuntos = (s.adjuntos_ids ? adjTodos.filter(a => s.adjuntos_ids.includes(Number(a.id))) : adjTodos)\n  .sort((a, b) => (a.orden || 0) - (b.orden || 0));\nconst total = adjuntos.reduce((t, a) => t + (Number(a.tamano_bytes) || 0), 0);\nconst LIMITE = 20 * 1024 * 1024; // Gmail admite 25 MB; se deja margen por la codificacion\nif (total > LIMITE) { errores.push(`Los adjuntos suman ${(total / 1048576).toFixed(1)} MB y el límite es 20 MB. Elija menos archivos.`); codigo = 413; }\n\n// Fecha limite en dias habiles (sin festivos)\nconst limite = new Date();\nlet d = s.plazo_dias;\nwhile (d > 0) { limite.setDate(limite.getDate() + 1); const w = limite.getDay(); if (w !== 0 && w !== 6) d--; }\nconst fecha_limite = limite.toISOString().slice(0, 10);\n\nconst esc = t => String(t || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst etiqueta = `[SGD ${com.consecutivo || ''}]`;\nconst asunto = `${etiqueta} ${s.modo === 'devolver' ? 'Ajuste solicitado: ' : ''}${com.asunto || 'Comunicación'}`;\nconst lista = adjuntos.length ? '<ul>' + adjuntos.map(a => `<li>${esc(a.nombre_archivo)}</li>`).join('') + '</ul>' : '<p>Sin adjuntos.</p>';\nconst intro = s.modo === 'devolver'\n  ? '<p>Archivo Central le devuelve esta comunicación para que <b>ajuste la respuesta</b>.</p>'\n  : '<p>Archivo Central le remite la siguiente comunicación para su trámite.</p>';\nconst html = `${intro}\n<table cellpadding=\"4\" style=\"border-collapse:collapse;font-family:Arial,sans-serif;font-size:13px\">\n<tr><td><b>Consecutivo</b></td><td>${esc(com.consecutivo)}</td></tr>\n<tr><td><b>Remitente</b></td><td>${esc(com.remitente_nombre)} &lt;${esc(com.remitente_email)}&gt;</td></tr>\n<tr><td><b>Fecha de recepción</b></td><td>${esc((com.fecha_recepcion || '').slice(0, 10))}</td></tr>\n<tr><td><b>Asunto</b></td><td>${esc(com.asunto)}</td></tr>\n<tr><td><b>Responder antes de</b></td><td>${fecha_limite}</td></tr>\n</table>\n${s.mensaje ? `<p><b>Mensaje de Archivo Central:</b><br>${esc(s.mensaje).replace(/\\n/g, '<br>')}</p>` : ''}\n<p><b>Texto original:</b></p>\n<blockquote style=\"border-left:3px solid #ccc;padding-left:8px;color:#444\">${esc((com.cuerpo || '').slice(0, 8000)).replace(/\\n/g, '<br>')}</blockquote>\n<p><b>Adjuntos:</b></p>${lista}\n<p style=\"color:#7f6000\"><b>Importante:</b> responda a este mismo correo y <b>no cambie el asunto</b>; así su respuesta queda asociada automáticamente a ${esc(com.consecutivo)}.</p>`;\n\nreturn [{ json: {\n  ok: errores.length === 0, errores, codigo,\n  comunicacion_id: s.comunicacion_id, consecutivo: com.consecutivo, dependencia_id: dep.id,\n  dependencia: dep.nombre, para: para.join(','), copia: copia.join(','),\n  asunto, html, fecha_limite, modo: s.modo, usuario: s.usuario,\n  adjuntos: adjuntos.map(a => ({ id: a.id, nombre: a.nombre_archivo }))\n} }];"
      },
