      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Valida lo que envia la aplicacion al pulsar \"Remitir\" (o \"Devolver\")\nconst b = $json.body || {};\nconst errores = [];\nconst comunicacion_id = parseInt(b.comunicacion_id, 10);\nconst dependencia_id = parseInt(b.dependencia_id, 10);\nconst modo = b.modo === 'devolver' ? 'devolver' : 'remitir';\nlet plazo = parseInt(b.plazo_dias, 10);\nif (!(plazo >= 1 && plazo <= 60)) plazo = 5; // plazo por defecto: 5 dias habiles\nif (!comunicacion_id) errores.push('Falta comunicacion_id.');\nif (!dependencia_id) errores.push('Falta dependencia_id.');\nconst adjuntos_ids = Array.isArray(b.adjuntos_ids) ? b.adjuntos_ids.map(Number).filter(Boolean) : null; // null = todos\nreturn { json: {\n  valido: errores.length === 0, errores,\n  comunicacion_id, dependencia_id, modo, plazo_dias: plazo,\n  mensaje: (b.mensaje || '').toString().slice(0, 5000),\n  adjuntos_ids,\n  usuario: b.usuario || 'archivo_central'\n} };"
      },
