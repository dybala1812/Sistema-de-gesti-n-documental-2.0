      "id": "76656fb3-9274-4f8a-9833-2a7ebdfe1d9c",
      "name": "Leer adjuntos",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1100,
        300
      ],
