    {
      "parameters": {
        "jsCode": "\nconst b = $input.first().json.body || {};\nconst num = (v) => (v !== null && v !== undefined && v !== '' && Number.isInteger(Number(v)) && Number(v) > 0) ? Number(v) : null;\nconst correo = /^[^\\s@<>,;]+@[^\\s@<>,;]+\\.[^\\s@<>,;]+$/;\nconst errores = [];\nconst comunicacion_id = num(b.comunicacion_id);\nconst usuario_id = num(b.usuario_id);\nif (!comunicacion_id) errores.push('comunicacion_id es obligatorio');\nif (!usuario_id) errores.push('usuario_id es obligatorio');\nif (!b.modo || !['recordatorio', 'adicional'].includes(b.modo)) errores.push(\"modo debe ser 'recordatorio' o 'adicional'\");\nif (!correo.test(String(b.destinatario_correo || ''))) errores.push('destinatario_correo es inválido');\nconst asunto = String(b.asunto || '').replace(/\\s+/g, ' ').trim();\nif (!asunto) errores.push('asunto es obligatorio');\nconst cuerpo = String(b.cuerpo || '').trim();\nif (!cuerpo) errores.push('cuerpo es obligatorio');\nif (b.adjuntos_ids !== undefined && b.adjuntos_ids !== null) {\n  const uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\n  if (!Array.isArray(b.adjuntos_ids) || b.adjuntos_ids.some(x => !uuid.test(String(x)))) errores.push('adjuntos_ids debe ser una lista de uuid');\n}\nif (b.modo === 'adicional') {\n  if (!b.destinatario_tipo || !['remitente', 'dependencia'].includes(b.destinatario_tipo)) {\n    errores.push(\"destinatario_tipo debe ser 'remitente' o 'dependencia'\");\n  }\n}\nif (errores.length) return [{ json: { ok: false, http: 400, error: 'solicitud_invalida', detalle: errores } }];\nreturn [{ json: { ok: true, ...b, comunicacion_id, usuario_id, asunto, cuerpo } }];\n"
      },
