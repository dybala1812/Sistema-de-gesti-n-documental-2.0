# ============================================================
#  Configuración de n8n (SGD) — copia este archivo como .env
# ============================================================

# --- Base de datos interna de n8n (Postgres en Docker) ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=cambia_esto
POSTGRES_DB=n8n

# --- n8n ---
N8N_VERSION=latest
# ¡No cambiar después de importar credenciales! (las cifra)
N8N_ENCRYPTION_KEY=cambia_esto
# Puerto en este PC (5678 ya lo usa otro n8n local)
N8N_HTTP_PORT=5679

# --- Backend SGD ---
# URL base del backend SGD (sin /api; los flujos agregan /api/n8n/...).
# Local: http://host.docker.internal:3000
# Producción (Render): https://sistema-de-gesti-n-documental-2-0.onrender.com
BACKEND_URL=https://sistema-de-gesti-n-documental-2-0.onrender.com
# Debe ser igual al N8N_SERVICE_TOKEN del backend. Sirve para las dos direcciones:
# n8n → backend (/api/n8n/*) y backend → webhooks de n8n (F2, F3, F4).
N8N_SERVICE_TOKEN=PEGAR_AQUI

# --- URL pública de n8n (para webhooks F2, F3, F4) ---
# Local: http://localhost:5679/
# Producción: https://tu-n8n.onrender.com/  (n8n debe estar expuesto en internet)
N8N_WEBHOOK_URL=http://localhost:5679/
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# --- Correo: buzón del Archivo Central ---
# El proveedor debe permitir IMAP/SMTP con usuario y contraseña (a veces "contraseña de aplicación").
# Recibir (F1) por IMAP. 993 = SSL/TLS (IMAP_SECURE=true).
IMAP_HOST=PEGAR_AQUI
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=PEGAR_AQUI
IMAP_PASSWORD=PEGAR_AQUI
# Enviar (F1 acuse, F2, F5) por SMTP. 465 = SSL/TLS (SMTP_SECURE=true); 587 = STARTTLS (SMTP_SECURE=false).
SMTP_HOST=PEGAR_AQUI
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=PEGAR_AQUI
SMTP_PASSWORD=PEGAR_AQUI
# Remitente que verá el destinatario. Vacío = SMTP_USER. Ej.: Archivo Central <archivo@dominio>
CORREO_REMITENTE=

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=PEGAR_AQUI
# Opcional: cambia el modelo del F1. Vacío = el del flujo (models/gemini-3.1-flash-lite).
# Capa gratuita: cuota diaria por modelo (gemini-3-flash-preview = 20/día). Recomendado: models/gemini-3.5-flash-lite
GEMINI_MODEL=models/gemini-3.5-flash-lite

# --- F7 · API de triaje (GET /correos, GET /estadisticas, PATCH /correos/:id) ---
# Cabecera X-API-Key que deben mandar los clientes de la API. Generar: openssl rand -hex 24
TRIAJE_API_KEY=PEGAR_AQUI
# Origen(es) del frontend permitidos por CORS, separados por coma. Ej.: https://nova.<dominio>
FRONTEND_ORIGEN=http://localhost:5173
