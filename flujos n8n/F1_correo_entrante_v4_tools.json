    {
      "id": "normalizar-v4",
      "name": "Normalizar correo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        300
      ],
      "parameters": {
        "jsCode": "\nconst it = $input.first();\nconst m = it.json;\nconst h = {};\nif (m.headers && typeof m.headers === 'object' && !Array.isArray(m.headers)) {\n  for (const [k, v] of Object.entries(m.headers)) h[k.toLowerCase()] = typeof v === 'string' ? v : (v && v.text) || JSON.stringify(v);\n}\nif (Array.isArray(m.payload?.headers)) for (const x of m.payload.headers) h[String(x.name).toLowerCase()] = x.value;\nconst gmail_id = m.id || $('Un correo a la vez').first().json.id;\nconst fromV = m.from?.value?.[0] || {};\nconst fromTxt = String(m.from?.text || (typeof m.from === 'string' ? m.from : '') || '');\nconst de_correo = String(fromV.address || (fromTxt.match(/<([^>]+)>/) || [])[1] || fromTxt).trim().toLowerCase();\nconst de_nombre = (fromV.name || '').trim() || null;\nconst asunto = String(m.subject || '(sin asunto)').replace(/\\s+/g, ' ').trim();\nlet cuerpo = String(m.text || '').trim();\nif (!cuerpo && m.html) {\n  cuerpo = String(m.html)\n    .replace(/<style[\\s\\S]*?<\\/style>/gi, '').replace(/<script[\\s\\S]*?<\\/script>/gi, '')\n    .replace(/<br\\s*\\/?>/gi, '\\n').replace(/<\\/(p|div|tr|li)>/gi, '\\n').replace(/<[^>]+>/g, '')\n    .replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '\"')\n    .replace(/\\n{3,}/g, '\\n\\n').trim();\n}\nconst message_id = String(m.messageId || h['message-id'] || `<gmail-${gmail_id}@sin-message-id>`).trim();\nconst in_reply_to = String(m.inReplyTo || h['in-reply-to'] || '').trim() || null;\nconst refsRaw = m.references || h['references'] || '';\nconst references = (Array.isArray(refsRaw) ? refsRaw : String(refsRaw).split(/\\s+/)).filter(Boolean);\nconst fecha = new Date(m.date || Date.now());\nconst recibido_en = (isNaN(fecha) ? new Date() : fecha).toISOString();\nconst ids_citados = [...new Set([in_reply_to, ...references].filter(Boolean))];\nconst tiene_etiqueta = /\\[SGD\\s/i.test(asunto);\nconst attachmentKeys = Object.keys(it.binary || {}).filter(k => k.startsWith('attachment_'));\nreturn [{ json: { gmail_id, message_id, in_reply_to, references, ids_citados, de_nombre, de_correo, asunto, cuerpo: cuerpo.slice(0, 15000), recibido_en, tiene_etiqueta, tiene_adjuntos: attachmentKeys.length > 0, adjuntos_binarios: attachmentKeys } }];\n"
      }
    },
    {
      "id": "agente-v4",
      "name": "Agente clasificador (tools)",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1300,
        300
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ 'CORREO A CLASIFICAR\\nDe: ' + $json.de_nombre + ' <' + $json.de_correo + '>\\nAsunto: ' + $json.asunto + '\\nCuerpo:\\n' + String($json.cuerpo || '').slice(0, 4000) + '\\n\\nMETADATOS\\nMessage-ID: ' + $json.message_id + '\\nIn-Reply-To: ' + ($json.in_reply_to || 'ninguno') + '\\nReferences: ' + ($json.references || []).join(', ') + '\\n¿Tiene etiqueta [SGD]?: ' + ($json.tiene_etiqueta ? 'SÍ' : 'NO') + '\\n¿Tiene adjuntos?: ' + ($json.tiene_adjuntos ? 'SÍ' : 'NO') }}",
        "options": {
          "systemMessage": "Eres un clasificador experto de correspondencia para el Archivo Central de una universidad. Tu trabajo es decidir qué tipo de correo acaba de llegar. Tienes herramientas para consultar el backend SGD cuando lo necesites. REGLAS: 1) Primero consulta si el Message-ID ya fue procesado; si ya existe o es propio, clasifica como spam. 2) Si el asunto/cuerpo indican rebote (delivery failure, undeliverable, bounce), clasifica como rebote. 3) Si el asunto empieza con Re:/RV:/FW:, tiene In-Reply-To, etiqueta [SGD ...] o el remitente es una dependencia, es respuesta_dependencia. Busca la comunicación por consecutivo o remitente para obtener comunicacion_id. 4) Si es remitente externo/estudiante sin vínculo, es correo_nuevo. 5) Si parece respuesta pero no se puede vincular, es sin_asociar. 6) Publicidad/newsletters/spam → spam. Responde ÚNICAMENTE con JSON: {\"tipo\": \"respuesta_dependencia\"|\"correo_nuevo\"|\"sin_asociar\"|\"spam\"|\"rebote\", \"comunicacion_id\": <número o null>, \"dependencia_id\": <número o null>, \"motivo\": \"<una frase>\"}.",
          "maxIterations": 5
        }
      },
      "onError": "continueRegularOutput"
    },
