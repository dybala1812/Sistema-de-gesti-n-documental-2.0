      "parameters": {
        "jsCode": "\nconst items = $input.all();\nconst origen = items[0]?.json.origen || {};\nconst archivo_ids = items.map(i => i.json.id).filter(Boolean);\nconst adjuntos_omitidos = items.filter(i => !i.json.id).map(i => ({ nombre: i.json.binary_key, motivo: 'Error al subir adjunto' }));\nreturn [{ json: { ...origen, archivo_ids, adjuntos_omitidos } }];\n"
      }
    },
