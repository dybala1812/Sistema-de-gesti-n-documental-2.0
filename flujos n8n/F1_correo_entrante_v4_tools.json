    {
      "id": "parsear-v4",
      "name": "Parsear clasificación",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2080,
        300
      ],
      "parameters": {
        "jsCode": "\nconst it = $input.first().json;\nconst n = it;\nconst crudo = String(it.output || '').replace(/```json|```/g, '').trim();\nlet tipo = 'correo_nuevo';\nlet comunicacion_id = null;\nlet dependencia_id = null;\nlet motivo = 'Clasificación por agente con tools';\ntry {\n  const j = JSON.parse(crudo.slice(crudo.indexOf('{'), crudo.lastIndexOf('}') + 1));\n  tipo = j.tipo || tipo;\n  comunicacion_id = j.comunicacion_id ?? comunicacion_id;\n  dependencia_id = j.dependencia_id ?? dependencia_id;\n  motivo = j.motivo || motivo;\n} catch (e) {\n  if (/delivery failure|undeliverable|bounce|no such user/i.test(n.asunto + ' ' + n.cuerpo)) tipo = 'rebote';\n  else if (/unsubscribe|newsletter|promoción|oferta|publicidad/i.test(n.asunto + ' ' + n.cuerpo)) tipo = 'spam';\n  motivo = 'Fallback por error en respuesta del agente';\n}\nreturn [{ json: { ...n, tipo, comunicacion_id, dependencia_id, motivo } }];\n"
      }
    },
