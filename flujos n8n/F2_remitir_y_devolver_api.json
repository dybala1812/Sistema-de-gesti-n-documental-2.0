      "id": "f258d6c1-3b35-48a8-86fc-cbd71f01557a",
      "name": "Leer comunicación y dependencia",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        170
      ],
      "credentials": {
        "httpHeaderAuth": {
