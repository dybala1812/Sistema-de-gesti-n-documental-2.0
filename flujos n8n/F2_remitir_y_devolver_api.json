    {
      "parameters": {
        "jsCode": "\nconst e = $('Validar solicitud').first().json;\nconst r = $input.first().json;\nconst fail = (http, error, detalle) => [{ json: { ok: false, http, error, detalle } }];\nconst correo = /^[^\\s@<>,;]+@[^\\s@<>,;]+\\.[^\\s@<>,;]+$/;\nif (!r.id) return fail(404, 'comunicacion_no_existe', `No existe la comunicación ${e.comunicacion_id}`);\nif (r.tipo !== 'ENT') return fail(409, 'solo_entradas', 'Solo se remiten o devuelven comunicaciones de entrada (ENT).');\nif (!r.dep_id) return fail(404, 'dependencia_no_existe', 'La dependencia no existe o la comunicación no tiene dependencia.');\nconst esperado = e.modo === 'remitir' ? 'nueva' : 'respondida_dependencia';\nif (r.estado !== esperado) return fail(409, 'estado_no_permite_' + e.modo, `La comunicación está en \"${r.estado}\"; para ${e.modo} debe estar en \"${esperado}\".`);\nif (r.dep_estado !== 'activo') return fail(422, 'dependencia_inactiva', 'La dependencia no está activa.');\nif (!correo.test(r.correo_oficial || '')) return fail(422, 'dependencia_sin_correo', 'La dependencia no tiene un correo oficial válido.');\nconst plazo = e.plazo_dias_habiles ?? (Number(r.plazo_defecto) || null);\nif (e.modo === 'remitir' && !(plazo > 0)) return fail(422, 'sin_plazo', 'Falta el plazo (parámetro plazo_respuesta_dias_habiles).');\nconst propios = new Set((r.adjuntos || []).map(String));\nconst ajenos = e.archivo_ids.filter(x => !propios.has(x));\nif (ajenos.length) return fail(422, 'adjuntos_no_pertenecen', `Estos archivos no son adjuntos de la comunicación: ${ajenos.join(', ')}`);\nreturn [{ json: { ok: true, ...e, dependencia_id: r.dep_id, plazo_dias_habiles: plazo,\n                  consecutivo: r.consecutivo, asunto: r.asunto, dependencia: r.dependencia, correo_oficial: r.correo_oficial } }];\n"
      },
