    {
      "parameters": {
        "jsCode": "\nconst v = $('Validar estado y dependencia').first().json;\nconst envio = $('Enviar correo (F5)').first().json;\nconst filas = $input.all().map(i => i.json);\nconst fila = filas.find(f => f.consecutivo || f.fecha_limite || f.estado) || filas[0] || {};\nreturn [{ json: {\n  ok: true,\n  modo: v.modo,\n  comunicacion_id: v.comunicacion_id,\n  consecutivo: v.consecutivo,\n  estado: v.modo === 'remitir' ? 'remitida' : 'devuelta',\n  fecha_limite: fila.fecha_limite ?? null,\n  message_id: envio.message_id\n} }];\n"
      },
