        "jsCode": "\nconst v = $input.first().json;\nconst remitir = v.modo === 'remitir';\nreturn [{ json: {\n  plantilla: remitir ? 'remision' : 'devolucion',\n  destinatario_correo: v.correo_oficial,\n  consecutivo: v.consecutivo,\n  variables: {\n    nombre: v.dependencia, dependencia: v.dependencia, asunto: v.asunto,\n    plazo: remitir ? `${v.plazo_dias_habiles} días hábiles` : '',\n    respuesta: v.mensaje, mensaje: v.mensaje\n  },\n  archivo_ids: v.archivo_ids,\n  contexto: { comunicacion_id: v.comunicacion_id }\n} }];\n"
