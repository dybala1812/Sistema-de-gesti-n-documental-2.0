    {
      "parameters": {
        "jsCode": "\nconst b = $input.first().json.body || {};\nconst num = (v) => (v !== null && v !== undefined && v !== '' && Number.isInteger(Number(v)) && Number(v) > 0) ? Number(v) : null;\nconst uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nconst errores = [];\nconst modo = b.modo || 'remitir';\nif (!['remitir', 'devolver'].includes(modo)) errores.push('modo debe ser \"remitir\" o \"devolver\"');\nconst comunicacion_id = num(b.comunicacion_id);\nif (!comunicacion_id) errores.push('comunicacion_id es obligatorio');\nconst usuario_id = num(b.usuario_id);\nif (!usuario_id) errores.push('usuario_id es obligatorio (quién actúa, para la auditoría)');\nconst dependencia_id = num(b.dependencia_id);\nif (modo === 'remitir' && !dependencia_id) errores.push('dependencia_id es obligatorio al remitir');\nconst plazoCrudo = b.plazo_dias_habiles ?? b.plazo_dias ?? null;\nconst plazo = num(plazoCrudo);\nif (plazoCrudo !== null && plazoCrudo !== '' && !plazo) errores.push('plazo_dias_habiles debe ser un entero positivo');\nconst archivo_ids = Array.isArray(b.archivo_ids) ? b.archivo_ids.map(String) : [];\nif (archivo_ids.some(x => !uuid.test(x))) errores.push('archivo_ids debe contener uuid');\nif (errores.length) return [{ json: { ok: false, http: 400, error: 'solicitud_invalida', detalle: errores } }];\nreturn [{ json: { ok: true, modo, comunicacion_id, dependencia_id, usuario_id, plazo_dias_habiles: plazo,\n                  mensaje: String(b.mensaje || '').slice(0, 5000), archivo_ids } }];\n"
      },
