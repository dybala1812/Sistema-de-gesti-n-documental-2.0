      "id": "e0fa7bf2-ffa3-4303-ace2-65eb674e46cf",
      "name": "Llamado desde otro flujo",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        170
      ]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "plantilla_correo",
        "returnAll": false,
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "codigo",
              "condition": "eq",
              "keyValue": "={{ $json.plantilla || '' }}"
            }
          ]
        },
        "limit": 1
      },
      "id": "d2d76a2f-6228-4201-bfb1-d714bcbd37bd",
      "name": "Leer plantilla",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        260,
        170
      ],
      "credentials": {
        "supabaseApi": {
          "id": "REEMPLAZAR",
          "name": "Supabase SGD (service_role)"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "\n// Entrada esperada (la arma quien llama):\n// { plantilla, destinatario_correo, consecutivo | consecutivos[], variables{}, archivo_ids[], contexto{} }\nconst entrada = $('Llamado desde otro flujo').first().json;\nconst plantilla = $input.first().json;\nif (!plantilla || !plantilla.codigo) {\n  throw new Error(`F5: no existe la plantilla \"${entrada.plantilla}\" en plantilla_correo`);\n}\nconst correoValido = /^[^\\s@<>,;]+@[^\\s@<>,;]+\\.[^\\s@<>,;]+$/;\nconst para = String(entrada.destinatario_correo || '').trim();\nif (!correoValido.test(para)) throw new Error(`F5: destinatario inválido: \"${para}\"`);\n\nconst consecutivos = [].concat(entrada.consecutivos || entrada.consecutivo || []).filter(Boolean);\nif (!consecutivos.length && entrada.plantilla !== 'resumen') {\n  throw new Error('F5: falta el consecutivo; todo correo del sistema lleva [SGD <consecutivo>] en el asunto');\n}\nconst hoy = new Date().toLocaleDateString('es-CO', { timeZone: 'America/Bogota', day: '2-digit', month: '2-digit', year: 'numeric' });\nconst vars = Object.assign({ fecha: hoy, consecutivo: consecutivos.join(', ') }, entrada.variables || {});\nconst render = (t) => String(t ?? '').replace(/\\{(\\w+)\\}/g, (_, k) => (vars[k] === undefined || vars[k] === null) ? '' : String(vars[k]));\n\nlet asunto = render(plantilla.asunto).replace(/\\s+/g, ' ').trim();\nconst faltan = consecutivos.filter(c => !asunto.includes(`[SGD ${c}]`));\nif (faltan.length) asunto = faltan.map(c => `[SGD ${c}]`).join(' ') + ' ' + asunto;\n\nreturn [{ json: {\n  to: para,\n  asunto,\n  cuerpo: render(plantilla.cuerpo),\n  archivo_ids: entrada.archivo_ids || [],\n  contexto: entrada.contexto ?? null\n} }];\n"
      },
      "id": "86b18456-4311-44ea-8b5f-9b4222e1f2b9",
      "name": "Armar mensaje y etiqueta [SGD]",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        170
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "9a420371-54f6-4f66-a5e0-be2b1c2b00ed",
              "leftValue": "={{ $json.archivo_ids.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b042e7cc-f3e9-4a12-adb3-af663c1d5c6f",
      "name": "¿Lleva adjuntos?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        780,
        170
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst m = $input.first().json;\nreturn m.archivo_ids.map((id, i) => ({ json: { archivo_id: id, orden: i } }));\n"
      },
      "id": "677218be-906d-41d5-8f22-84e063c61701",
      "name": "Separar ids de archivo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://BACKEND_URL_AQUI/api/archivos/{{ $json.archivo_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "id": "83ae2050-7a80-4f09-88bc-2660af2edc16",
      "name": "Descargar adjunto del backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1300,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR",
          "name": "Backend SGD (Bearer N8N_SERVICE_TOKEN)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "\nconst base = $('Armar mensaje y etiqueta [SGD]').first().json;\nconst binary = {};\n$input.all().forEach((it, i) => { binary['adjunto_' + i] = it.binary.data; });\nreturn [{ json: { ...base, binarios: Object.keys(binary).join(',') }, binary }];\n"
      },
      "id": "c64dd86d-1481-4362-ad60-3963936508a2",
      "name": "Reunir adjuntos en un solo correo",
