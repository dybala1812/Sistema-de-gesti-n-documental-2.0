    {
      "parameters": {
        "jsCode": "\n// Devuelve a quien llamó el Message-ID real del correo enviado, para guardarlo en comunicacion_evento.message_id\nconst ctx = $('Armar mensaje y etiqueta [SGD]').first().json;\nconst m = $input.first().json;\nconst hdr = m.headers && (m.headers['message-id'] || m.headers['Message-ID']);\nlet message_id = m.messageId || hdr || null;\nlet advertencia = null;\nif (!message_id) {\n  // El correo YA salió; no se debe fallar aquí (se reenviaría). Se deja un id sintético y se avisa.\n  message_id = `<sgd-gmail-${m.id}@sin-message-id>`;\n  advertencia = 'No se pudo leer el Message-ID real; las respuestas se asociarán solo por la etiqueta [SGD].';\n}\nreturn [{ json: { ok: true, message_id, enviado_en: new Date().toISOString(), gmail_id: m.id || null,\n                  destinatario: ctx.to, advertencia, contexto: ctx.contexto } }];\n"
      },
      "id": "de1e1cfc-7777-4e03-b271-f8d60abf56cd",
      "name": "Resultado del envío",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
