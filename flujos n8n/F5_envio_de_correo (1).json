      "id": "a828188a-1311-4fca-b502-959b5d84d175",
      "name": "Leer el correo enviado (Message-ID)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        2080,
        170
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "REEMPLAZAR",
          "name": "Buzón Archivo Central (Gmail)"
        }
      },
