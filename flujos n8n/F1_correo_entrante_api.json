    {
      "parameters": {
        "jsCode": "\nconst n = $('Normalizar correo').first().json;\nconst q = $('Consultar estado del correo').first().json;\nlet ruta, motivo = null, posible = null;\nconst esRe = /^\\s*(re|rv|fw|fwd)\\s*:/i.test(n.asunto);\n\nif (q.ya_procesado || q.es_propio) {\n  ruta = 'descartar';                                   // ya registrado, o es un correo del propio buzón\n} else if (q.comunicacion_id) {\n  if (q.dependencia_id) { ruta = 'A'; }                 // respuesta de una dependencia\n  else { ruta = 'C'; motivo = 'otro'; posible = q.comunicacion_id; }   // responde a una comunicación pero no es una dependencia\n} else if (n.tiene_etiqueta) {\n  ruta = 'C'; motivo = 'etiqueta_no_coincide';\n} else if (q.dependencia_id) {\n  ruta = 'C'; motivo = 'sin_etiqueta';\n} else if (esRe) {\n  ruta = 'C'; motivo = 'remitente_externo_sin_etiqueta';\n} else {\n  ruta = 'B';                                           // correo nuevo\n}\nreturn [{ json: { ruta, motivo, posible_comunicacion_id: posible,\n                  comunicacion_id: q.comunicacion_id || null, dependencia_id: q.dependencia_id || null } }];\n"
      },
