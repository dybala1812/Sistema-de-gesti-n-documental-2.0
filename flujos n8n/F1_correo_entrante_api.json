      "id": "a50a077e-0b53-4cf8-bcaf-ebbb0e428239",
      "name": "Obtener correo completo",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        780,
        510
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "REEMPLAZAR",
          "name": "Buzón Archivo Central (Gmail)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "\nconst it = $input.first();\nconst m = it.json;\n\n// encabezados (mailparser los entrega como objeto; con payload crudo vienen como lista)\nconst h = {};\nif (m.headers && typeof m.headers === 'object' && !Array.isArray(m.headers)) {\n  for (const [k, v] of Object.entries(m.headers)) h[k.toLowerCase()] = typeof v === 'string' ? v : (v && v.text) || JSON.stringify(v);\n}\nif (Array.isArray(m.payload?.headers)) for (const x of m.payload.headers) h[String(x.name).toLowerCase()] = x.value;\n\nconst gmail_id = m.id || $('Un correo a la vez').first().json.id;\nconst fromV = m.from?.value?.[0] || {};\nconst fromTxt = String(m.from?.text || (typeof m.from === 'string' ? m.from : '') || '');\nconst de_correo = String(fromV.address || (fromTxt.match(/<([^>]+)>/) || [])[1] || fromTxt).trim().toLowerCase();\nconst de_nombre = (fromV.name || '').trim() || null;\nconst asunto = String(m.subject || '(sin asunto)').replace(/\\s+/g, ' ').trim();\n\n// cuerpo en TEXTO PLANO (nunca guardar HTML sin sanitizar)\nlet cuerpo = String(m.text || '').trim();\nif (!cuerpo && m.html) {\n  cuerpo = String(m.html)\n    .replace(/<style[\\s\\S]*?<\\/style>/gi, '').replace(/<script[\\s\\S]*?<\\/script>/gi, '')\n    .replace(/<br\\s*\\/?>/gi, '\\n').replace(/<\\/(p|div|tr|li)>/gi, '\\n').replace(/<[^>]+>/g, '')\n    .replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '\"')\n    .replace(/\\n{3,}/g, '\\n\\n').trim();\n}\n\nconst message_id = String(m.messageId || h['message-id'] || `<gmail-${gmail_id}@sin-message-id>`).trim();\nconst in_reply_to = String(m.inReplyTo || h['in-reply-to'] || '').trim() || null;\nconst refsRaw = m.references || h['references'] || '';\nconst references = (Array.isArray(refsRaw) ? refsRaw : String(refsRaw).split(/\\s+/)).filter(Boolean);\nconst fecha = new Date(m.date || Date.now());\nconst recibido_en = (isNaN(fecha) ? new Date() : fecha).toISOString();\n\n// Message-ID citados (para ubicar el envío original de un rebote)\nconst citados = [...new Set([in_reply_to, ...references, ...(cuerpo.match(/<[^<>\\s]+@[^<>\\s]+>/g) || [])].filter(Boolean))]\n  .filter(x => x !== message_id).slice(0, 30);\n\nconst es_rebote = /mailer-daemon|postmaster/i.test(de_correo) ||\n  /(undelivered|delivery status notification|mail delivery (failed|subsystem)|returned mail|failure notice|no se pudo entregar|no entregado|error de entrega)/i.test(asunto);\nconst autoSub = (h['auto-submitted'] || '').toLowerCase();\nconst es_automatico = (autoSub && autoSub !== 'no') || !!h['x-autoreply'] || !!h['x-autorespond'] ||\n  /auto_reply|auto-reply|bulk|junk/i.test(h['precedence'] || '') ||\n  /(fuera de (la )?oficina|out of office|respuesta autom[aá]tica|automatic reply|auto-?reply|ausente)/i.test(asunto);\n\nconst adjuntos_n = Object.keys(it.binary || {}).filter(k => k.startsWith('attachment_')).length;\n\nreturn [{ json: { gmail_id, message_id, in_reply_to, de_correo, de_nombre, asunto, cuerpo, recibido_en,\n                  anio: new Date(recibido_en).getUTCFullYear(), ids_citados: citados,\n                  tiene_etiqueta: /\\[SGD\\s+[A-Z]{3}-\\d{4}-\\d+\\]/i.test(asunto),\n                  es_rebote, es_automatico, adjuntos_n },\n          binary: it.binary || {} }];\n"
      },
