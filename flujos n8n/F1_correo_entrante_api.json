    {
      "parameters": {
        "jsCode": "\nconst enviados = $('Separar adjuntos').all().map(i => i.json.nombre);\nconst ok = [], fallos = [];\nfor (const it of $input.all()) {\n  const j = it.json;\n  if (j.archivo_id) { ok.push(j); continue; }\n  const msg = String(j.error?.message || j.error || JSON.stringify(j)).slice(0, 400);\n  if (/\\b413\\b/.test(msg)) { fallos.push({ razon: 'tamano_excedido' }); continue; }       // se registra sin ese adjunto\n  if (/\\b415\\b/.test(msg)) { fallos.push({ razon: 'formato_no_permitido' }); continue; }\n  if (/\\b401\\b/.test(msg)) throw new Error('El backend rechazó el token de n8n (401). Revisar N8N_SERVICE_TOKEN.');\n  throw new Error('No se pudo subir un adjunto al backend: ' + msg);                     // el correo NO se marca como leído\n}\n// nombres de los que no se subieron = enviados menos los que volvieron con archivo_id\nconst pendientes = [...enviados];\nfor (const o of ok) { const ix = pendientes.indexOf(o.nombre_original); if (ix >= 0) pendientes.splice(ix, 1); }\nfallos.forEach((f, i) => { f.nombre = pendientes[i] || 'adjunto'; });\nreturn [{ json: { archivo_ids: ok.map(o => o.archivo_id), adjuntos_omitidos: fallos } }];\n"
      },
