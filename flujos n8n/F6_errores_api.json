  "nodes": [
    {
      "parameters": {},
      "id": "fffc0e93-26fd-4099-90d0-c71dc5f429dc",
      "name": "Falla en un flujo",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        170
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst e = $input.first().json;\nconst msg = (e.execution?.error?.message || 'sin mensaje').toString().slice(0, 1000);\nreturn [{ json: {\n  flujo: e.workflow?.name || 'desconocido',\n  ejecucion: String(e.execution?.id ?? ''),\n  nodo: e.execution?.lastNodeExecuted || null,\n  mensaje: msg,\n  url: e.execution?.url || null,\n  hora: new Date().toISOString()\n} }];\n"
      },
      "id": "d3b405e6-d9b2-4155-af13-de0ed7823c82",
      "name": "Preparar registro",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        170
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://BACKEND_URL_AQUI/api/n8n/auditoria/error-flujo",
        "authentication": "genericCredentialType",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ flujo: $json.flujo, ejecucion: $json.ejecucion, nodo: $json.nodo ?? null, mensaje: $json.mensaje, url: $json.url ?? null }) }}",
        "options": {
          "timeout": 60000
        },
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "1ef772c8-4018-462b-87e3-3c8e5efebb96",
      "name": "Registrar en auditoría",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        170
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR",
          "name": "Backend SGD (Bearer N8N_SERVICE_TOKEN)"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "\n// Primer error: avisa de inmediato. Los siguientes se acumulan y salen juntos\n// con el primer error posterior a la ventana de 15 minutos.\nconst e = $('Preparar registro').first().json;\nconst sd = $getWorkflowStaticData('global');\nsd.pendientes = sd.pendientes || [];\nsd.pendientes.push({ flujo: e.flujo, nodo: e.nodo, mensaje: e.mensaje, ejecucion: e.ejecucion, url: e.url, hora: e.hora });\nif (sd.pendientes.length > 50) sd.pendientes = sd.pendientes.slice(-50);\nconst ahora = Date.now();\nif (!sd.ultimo_aviso || ahora - sd.ultimo_aviso > 15 * 60 * 1000) {\n  const lote = sd.pendientes;\n  sd.pendientes = [];\n  sd.ultimo_aviso = ahora;\n  return [{ json: { avisar: true, lote } }];\n}\nreturn [{ json: { avisar: false, lote: [] } }];\n"
      },
      "id": "39cd526a-103f-4838-95c2-9ad3dc3a859f",
      "name": "Agrupar avisos (máx. 1 cada 15 min)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        170
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
