    {
      "parameters": {
        "jsCode": "\n// Cambiar por el correo del equipo técnico:\nconst EQUIPO_TECNICO = 'REEMPLAZAR@uniautonoma.edu.co';\nconst lote = $('Agrupar avisos (máx. 1 cada 15 min)').first().json.lote;\nconst b = $input.first().json.valor;\nconst buzon = (typeof b === 'string' ? b : '').replace(/^\"+|\"+$/g, '').trim();\nconst destinos = [buzon, EQUIPO_TECNICO].filter(Boolean).join(',');\nconst lineas = lote.map(x => `• ${x.hora} · ${x.flujo} · nodo: ${x.nodo || '?'}\\n  ${x.mensaje}\\n  ${x.url || ''}`).join('\\n\\n');\nreturn [{ json: {\n  to: destinos,\n  asunto: `[SGD] Error en flujos n8n (${lote.length})`,\n  cuerpo: `Se registraron ${lote.length} error(es) en los flujos de la Bandeja de comunicaciones:\\n\\n${lineas}\\n\\nQuedaron en la auditoría (error_flujo).`\n} }];\n"
      },
