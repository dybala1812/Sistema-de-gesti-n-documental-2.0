    {
      "parameters": {
        "jsCode": "\n// Un correo por dependencia con todas sus pendientes.\nconst r = $input.item.json;\nconst p = r.pendientes || [];\nconst lista = p.map(x => `- ${x.consecutivo} · ${x.asunto} · límite ${String(x.fecha_limite).slice(0, 10)} · vencida hace ${x.dias_vencida} día(s)`).join('\\n');\nreturn { json: {\n  plantilla: 'recordatorio',\n  destinatario_correo: r.correo_oficial,\n  consecutivos: p.map(x => x.consecutivo),\n  variables: { nombre: r.nombre, dependencia: r.nombre, asunto: lista, pendientes: lista, consecutivo: p.map(x => x.consecutivo).join(', ') },\n  archivo_ids: [],\n  contexto: { dependencia_id: r.dependencia_id, comunicacion_ids: p.map(x => x.id) }\n} };\n",
        "mode": "runOnceForEachItem"
      },
