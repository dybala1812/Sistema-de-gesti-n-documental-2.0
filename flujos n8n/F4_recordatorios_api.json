    {
      "parameters": {
        "jsCode": "\nconst filas = $input.all().map(i => i.json);\nconst buzon = filas[0].buzon;\nconst por = (f) => filas.filter(f);\nconst nuevas = por(x => x.estado === 'nueva');\nconst vencidas = por(x => x.vencida);\nconst escalar = por(x => x.por_escalar);\nconst porDep = {};\nvencidas.forEach(x => { (porDep[x.dependencia || '(sin dependencia)'] ||= []).push(x.consecutivo); });\nconst bloque = (t, a) => a.length ? `${t}\\n${a.join('\\n')}` : `${t}\\n  (ninguna)`;\nconst detalle = [\n  bloque('NUEVAS SIN ATENDER:', nuevas.map(x => `- ${x.consecutivo} (${x.dias_desde_recepcion} día(s) desde la recepción)`)),\n  bloque('VENCIDAS POR DEPENDENCIA:', Object.entries(porDep).map(([d, c]) => `- ${d}: ${c.join(', ')}`)),\n  bloque('PARA ESCALAR (3.er recordatorio):', escalar.map(x => `- ${x.consecutivo} · ${x.dependencia || ''}`))\n].join('\\n\\n');\nreturn [{ json: {\n  plantilla: 'resumen',\n  destinatario_correo: buzon,\n  consecutivos: [],\n  variables: { nombre: 'Archivo Central',\n               asunto: `${filas.length} activas · ${nuevas.length} nuevas · ${vencidas.length} vencidas · ${escalar.length} por escalar`,\n               respuesta: detalle, pendientes: detalle, consecutivo: '' },\n  archivo_ids: [],\n  contexto: { resumen: true }\n} }];\n"
      },
      "id": "9f45ae42-5386-42e6-b403-3d317fce5024",
