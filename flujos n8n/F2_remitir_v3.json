    {
      "parameters": {
        "jsCode": "\nconst b = $input.first().json.body || {};\nconst num = (v) => (v !== null && v !== undefined && v !== '' && Number.isInteger(Number(v)) && Number(v) > 0) ? Number(v) : null;\nconst modo = b.modo === 'devolver' ? 'devolver' : 'remitir';\nconst errores = [];\nconst comunicacion_id = num(b.comunicacion_id);\nif (!comunicacion_id) errores.push('comunicacion_id es obligatorio');\nconst dependencia_id = num(b.dependencia_id);\nif (modo === 'remitir' && !dependencia_id) errores.push('dependencia_id es obligatorio al remitir');\nconst usuario_id = num(b.usuario_id) || num(b.usuario);\nif (!usuario_id) errores.push('usuario_id es obligatorio para auditoría');\nlet plazo = num(b.plazo_dias_habiles ?? b.plazo_dias);\nif (!plazo || plazo < 1 || plazo > 60) plazo = 5;\nconst adjuntos = Array.isArray(b.adjuntos_ids) ? b.adjuntos_ids.map(String) : (Array.isArray(b.archivo_ids) ? b.archivo_ids.map(String) : []);\nreturn [{ json: { ok: errores.length === 0, errores, modo, comunicacion_id, dependencia_id, usuario_id, plazo_dias_habiles: plazo, mensaje: String(b.mensaje || '').slice(0, 5000), adjuntos_ids: adjuntos } }];\n"
      },
