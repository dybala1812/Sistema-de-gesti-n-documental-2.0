      "parameters": {
        "jsCode": "\nconst envio = $input.first().json;\nif (!envio || !envio.id) return [{ json: { ok: false, http: 502, error: 'gmail_fallo', detalle: 'No se pudo enviar el correo' } }];\nconst hdr = envio.headers && (envio.headers['message-id'] || envio.headers['Message-ID']);\nconst message_id = envio.messageId || hdr || `<sgd-gmail-${envio.id}@sin-message-id>`;\nreturn [{ json: { ok: true, message_id, gmail_id: envio.id || null } }];\n"
      },
