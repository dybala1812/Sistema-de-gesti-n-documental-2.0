    {
      "parameters": {
        "jsCode": "\nconst s = $('Validar solicitud').first().json;\nconst r = $input.first().json;\nconst fail = (http, error, detalle) => [{ json: { ok: false, http, error, detalle } }];\nif (!r.id) return fail(404, 'comunicacion_no_existe', `No existe la comunicación ${s.comunicacion_id}`);\nif (r.tipo !== 'ENT') return fail(409, 'solo_entradas', 'Solo se remiten/devuelven comunicaciones de entrada.');\nconst esperado = s.modo === 'remitir' ? 'nueva' : 'respondida_dependencia';\nif (r.estado !== esperado) return fail(409, 'estado_no_permite', `La comunicación está en \"${r.estado}\" y debe estar en \"${esperado}\".`);\nif (r.dep_estado !== 'activo') return fail(422, 'dependencia_inactiva', 'La dependencia no está activa.');\nconst correo = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nif (!correo.test(r.correo_oficial || '')) return fail(422, 'dependencia_sin_correo', 'La dependencia no tiene correo oficial.');\nconst plazo = s.plazo_dias_habiles ?? (Number(r.plazo_defecto) || 5);\nreturn [{ json: { ok: true, ...s, consecutivo: r.consecutivo, asunto: r.asunto, cuerpo: r.cuerpo, remitente_nombre: r.remitente_nombre, remitente_correo: r.remitente_correo, dependencia: r.dependencia, correo_oficial: r.correo_oficial, adjuntos: r.adjuntos || [] } }];\n"
      },
