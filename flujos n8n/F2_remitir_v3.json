    {
      "parameters": {
        "jsCode": "\nconst v = $input.first().json;\nconst remitir = v.modo === 'remitir';\nconst asunto = `[SGD ${v.consecutivo}] ${remitir ? 'Remisión para gestión' : 'Devolución - se requiere complementar'}`;\nconst remitenteHtml = v.remitente_nombre || v.remitente_correo ? `<p><strong>Remitente original:</strong> ${v.remitente_nombre || ''} ${v.remitente_correo ? `(${v.remitente_correo})` : ''}</p>` : '';\nconst cuerpoHtml = v.cuerpo ? `<p><strong>Contenido:</strong></p><blockquote style=\"border-left: 3px solid #ccc; margin: 0; padding-left: 10px;\">${v.cuerpo.replace(/\\n/g, '<br>')}</blockquote>` : '';\nconst html = `<p>Estimada dependencia <strong>${v.dependencia}</strong>:</p>\n<p>En atención a la comunicación <strong>${v.consecutivo}</strong> sobre \"${v.asunto}\", ${remitir ? 'se remite para su gestión.' : 'se devuelve para complementar la respuesta.'}</p>\n${remitenteHtml}\n${cuerpoHtml}\n${v.mensaje ? `<p><strong>Mensaje del gestor:</strong> ${v.mensaje.replace(/\\n/g, '<br>')}</p>` : ''}\n<p>Plazo: ${v.plazo_dias_habiles} días hábiles.</p>\n<p>Cordialmente,<br>Archivo Central</p>`;\nreturn [{ json: { asunto, html, para: v.correo_oficial, consecutivo: v.consecutivo, ...v } }];\n"
      },
