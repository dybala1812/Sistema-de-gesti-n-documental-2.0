      "position": [
        0,
        80
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const c = $input.first().json;\nconst adjuntos = c.adjuntos || c.adjuntos_ids || [];\nif (!adjuntos.length) return [{ json: { sin_adjuntos: true } }];\nreturn adjuntos.map((id, i) => ({ json: { archivo_id: id, orden: i } }));"
      },
