    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const correo = $('Armar correo').first().json;\nconst binary = {};\nconst nombres = [];\nlet fallidos = [];\n$input.all().forEach(it => {\n  if (it.json && it.json.sin_adjuntos) return;\n  const b = it.binary && it.binary.archivo;\n  if (!b) { fallidos.push(it.json && it.json.archivo_id); return; }\n  const k = `attachment_${nombres.length}`;\n  binary[k] = b;\n  nombres.push(k);\n});\nreturn [{ json: { ...correo, binarios: nombres.join(','), adjuntos_fallidos: fallidos.filter(Boolean) }, binary }];"
      },
      "id": "reunir-adjuntos-v3",
