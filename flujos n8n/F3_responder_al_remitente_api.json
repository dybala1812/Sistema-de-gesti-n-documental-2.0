        "jsCode": "\nconst v = $('Validar estado y adjuntos').first().json;\nconst envio = $('Enviar correo (F5)').first().json;\nconst s = $input.first().json;\nreturn [{ json: { ok: true, comunicacion_id: v.comunicacion_id, entrada: v.consecutivo_entrada,\n                  salida_id: s.id, salida_consecutivo: s.consecutivo, estado: 'cerrada', message_id: envio.message_id } }];\n"
