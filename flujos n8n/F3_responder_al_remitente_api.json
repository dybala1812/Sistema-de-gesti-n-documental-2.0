      "parameters": {
        "jsCode": "\n// La etiqueta lleva el consecutivo de la ENTRADA: la salida (SAL) aún no existe\n// porque solo se registra si el envío sale bien.\nconst v = $input.first().json;\nreturn [{ json: {\n  plantilla: 'respuesta',\n  destinatario_correo: v.remitente_correo,\n  consecutivo: v.consecutivo_entrada,\n  variables: { nombre: v.remitente_nombre || v.remitente_correo, asunto: v.asunto, respuesta: v.cuerpo },\n  archivo_ids: v.archivo_ids,\n  contexto: { entrada_id: v.comunicacion_id }\n} }];\n"
      },
