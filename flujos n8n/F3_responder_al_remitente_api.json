    {
      "parameters": {
        "jsCode": "\nconst b = $input.first().json.body || {};\nconst num = (v) => (v !== null && v !== undefined && v !== '' && Number.isInteger(Number(v)) && Number(v) > 0) ? Number(v) : null;\nconst uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nconst errores = [];\nconst comunicacion_id = num(b.comunicacion_id);\nif (!comunicacion_id) errores.push('comunicacion_id es obligatorio');\nconst usuario_id = num(b.usuario_id);\nif (!usuario_id) errores.push('usuario_id es obligatorio (quién actúa, para la auditoría)');\nconst cuerpo = String(b.cuerpo || '').trim();\nif (!cuerpo) errores.push('cuerpo es obligatorio');\nlet archivo_ids = null;\nif (b.archivo_ids !== undefined && b.archivo_ids !== null) {\n  if (!Array.isArray(b.archivo_ids) || b.archivo_ids.some(x => !uuid.test(String(x)))) errores.push('archivo_ids debe ser una lista de uuid');\n  else archivo_ids = b.archivo_ids.map(String);\n}\nif (errores.length) return [{ json: { ok: false, http: 400, error: 'solicitud_invalida', detalle: errores } }];\nreturn [{ json: { ok: true, comunicacion_id, usuario_id, cuerpo: cuerpo.slice(0, 20000),\n                  asunto: b.asunto ? String(b.asunto).replace(/\\s+/g, ' ').trim().slice(0, 300) : null,\n                  destinatario: b.destinatario ? String(b.destinatario).trim() : null, archivo_ids } }];\n"
      },
      "id": "979bdfd9-1db7-4736-a362-b15c079ecaf9",
