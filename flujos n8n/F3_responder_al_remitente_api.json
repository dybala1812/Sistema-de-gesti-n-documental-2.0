      "id": "93aa65a6-f5bf-4a7c-98f6-a60e12756af9",
      "name": "Leer comunicación de entrada",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        170
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR",
          "name": "Backend SGD (Bearer N8N_SERVICE_TOKEN)"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "\nconst e = $('Validar solicitud').first().json;\nconst r = $input.first().json;\nconst fail = (http, error, detalle) => [{ json: { ok: false, http, error, detalle } }];\nconst correo = /^[^\\s@<>,;]+@[^\\s@<>,;]+\\.[^\\s@<>,;]+$/;\nif (!r.id) return fail(404, 'comunicacion_no_existe', `No existe la comunicación ${e.comunicacion_id}`);\nif (r.tipo !== 'ENT') return fail(409, 'solo_entradas', 'Solo se responde una comunicación de entrada (ENT).');\nif (r.estado !== 'respondida_dependencia') return fail(409, 'estado_no_permite_responder', `La comunicación está en \"${r.estado}\"; debe estar en \"respondida_dependencia\".`);\nif (!correo.test(r.remitente_correo || '')) return fail(422, 'remitente_sin_correo', 'La entrada no tiene un correo de remitente válido.');\nif (e.destinatario && e.destinatario.toLowerCase() !== r.remitente_correo.toLowerCase())\n  return fail(400, 'destinatario_no_coincide', 'La respuesta solo puede ir al remitente de la entrada.');\nconst adj = r.adjuntos || [];\nlet ids;\nif (e.archivo_ids) {\n  const propios = new Set(adj.map(a => a.archivo_id));\n  const ajenos = e.archivo_ids.filter(x => !propios.has(x));\n  if (ajenos.length) return fail(422, 'adjuntos_no_pertenecen', `Estos archivos no son adjuntos de la comunicación: ${ajenos.join(', ')}`);\n  ids = e.archivo_ids;\n} else {\n  ids = adj.filter(a => a.de_dependencia).map(a => a.archivo_id);   // por defecto: los de la respuesta de la dependencia\n}\nconst asunto = e.asunto || (/^\\s*(re|rv)\\s*:/i.test(r.asunto) ? r.asunto : `RE: ${r.asunto}`);\nreturn [{ json: { ok: true, ...e, archivo_ids: ids, asunto, consecutivo_entrada: r.consecutivo,\n                  remitente_nombre: r.remitente_nombre, remitente_correo: r.remitente_correo } }];\n"
      },
