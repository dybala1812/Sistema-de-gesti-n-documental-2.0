# SGD · Archivo Central — variables de producción para docker-compose.yml.
# Copiar a .env (que no se sube a Git) y completar. Nunca poner valores reales en este archivo.
# Claves: generar con `openssl rand -hex 32` (solo letras y números: van dentro de una URL de conexión).

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# Superusuario de la base: solo lo usan el contenedor de migraciones y el administrador.
POSTGRES_PASSWORD=
# Rol con el que se conecta el backend (sgd_backend). Lo crea/actualiza el contenedor de migraciones.
SGD_BACKEND_PASSWORD=

# ── Backend ─────────────────────────────────────────────────────────────────
# Backend de NOVA que valida el token de cada usuario (sin /api al final).
NOVA_API_URL=
# Dirección pública del frontend de NOVA (CORS), separadas por comas. Ej.: https://nova.<dominio>
ALLOWED_ORIGINS=
# Red de Docker donde corre NOVA (`docker network ls`). El backend se une a ella con el alias
# sgd_backend y el nginx de NOVA lo publica en https://<dominio de NOVA>/sgd-api/.
RED_NOVA=
# Puerto del backend en el propio servidor (para revisar /api/salud). No se abre al público.
PUERTO_BACKEND=127.0.0.1:3000
# Zona horaria de los contenedores (la de la base define "hoy" y el año en consecutivos y plazos).
TZ=UTC

